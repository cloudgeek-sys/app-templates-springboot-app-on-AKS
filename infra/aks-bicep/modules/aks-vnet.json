{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "metadata": {
    "_generator": {
      "name": "bicep",
      "version": "0.24.24.22086",
      "templateHash": "14428864329398920138"
    }
  },
  "parameters": {
    "vnetName": {
      "type": "string"
    },
    "vnetPrefix": {
      "type": "string"
    },
    "aksSubnetPrefix": {
      "type": "string"
    },
    "ilbSubnetPrefix": {
      "type": "string"
    },
    "bastionSubnetPrefix": {
      "type": "string"
    },
    "fwSubnetPrefix": {
      "type": "string"
    },
    "mgmtSubnetPrefix": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "defaultValue": "eastus"
    }
  },
  "resources": [
    {
      "type": "Microsoft.Network/routeTables",
      "apiVersion": "2020-07-01",
      "name": "aksRouteTable",
      "location": "[parameters('location')]",
      "properties": {
        "routes": [
          {
            "properties": {
              "addressPrefix": "0.0.0.0/0",
              "nextHopType": "VirtualAppliance",
              "nextHopIpAddress": "10.50.4.4"
            },
            "name": "defaultRoute"
          }
        ],
        "disableBgpRoutePropagation": true
      }
    },
    {
      "type": "Microsoft.Network/virtualNetworks",
      "apiVersion": "2020-11-01",
      "name": "[parameters('vnetName')]",
      "location": "[parameters('location')]",
      "properties": {
        "addressSpace": {
          "addressPrefixes": [
            "[parameters('vnetPrefix')]"
          ]
        },
        "subnets": [
          {
            "name": "aks",
            "properties": {
              "addressPrefix": "[parameters('aksSubnetPrefix')]",
              "routeTable": {
                "id": "[resourceId('Microsoft.Network/routeTables', 'aksRouteTable')]"
              },
              "privateEndpointNetworkPolicies": "Disabled"
            }
          },
          {
            "name": "ilb",
            "properties": {
              "addressPrefix": "[parameters('ilbSubnetPrefix')]"
            }
          },
          {
            "name": "AzureBastionSubnet",
            "properties": {
              "addressPrefix": "[parameters('bastionSubnetPrefix')]"
            }
          },
          {
            "name": "AzureFirewallSubnet",
            "properties": {
              "addressPrefix": "[parameters('fwSubnetPrefix')]"
            }
          },
          {
            "name": "mgmt",
            "properties": {
              "addressPrefix": "[parameters('mgmtSubnetPrefix')]",
              "privateEndpointNetworkPolicies": "Disabled"
            }
          }
        ]
      },
      "dependsOn": [
        "[resourceId('Microsoft.Network/routeTables', 'aksRouteTable')]"
      ]
    }
  ],
  "outputs": {
    "bastionSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), 'AzureBastionSubnet')]"
    },
    "mgmtSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), 'mgmt')]"
    },
    "aksSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), 'aks')]"
    },
    "fwSubnetId": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks/subnets', parameters('vnetName'), 'AzureFirewallSubnet')]"
    },
    "Id": {
      "type": "string",
      "value": "[resourceId('Microsoft.Network/virtualNetworks', parameters('vnetName'))]"
    }
  }
}